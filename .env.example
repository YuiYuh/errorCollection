APP_NAME=wrongbook
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
EXPORT_DIR=./exports
LOG_DIR=./logs
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=180
AI_MAX_RETRIES=1
